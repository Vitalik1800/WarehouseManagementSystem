APP_NAME=WarehouseManagementSystem
APP_ENV=development
DEBUG=true

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=mysql+pymysql://warehouse_user:change_me@127.0.0.1:3306/warehouse_db?charset=utf8mb4

JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=INFO

FRONTEND_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_REQUEST_TIMEOUT=10